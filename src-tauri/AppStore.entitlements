<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required for App Store / TestFlight. ioreg + system_profiler work inside it. -->
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <!-- WKWebView renders nothing in a sandboxed app without this, even for the
       app's own bundled UI (verified: blank window without it). -->
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
